-- ── MODS LOOPS ──────────────────────────────────────────────
local function startAutoBuy()
    threads.autoBuy = task.spawn(function()
        while state.autoBuy do
            for _, data in ipairs(allPurchaseData) do
                if not state.autoBuy then break end
                if data.model:GetAttribute("Shown") == true then
                    pcall(function() data.remote:InvokeServer() end)
                    task.wait(0.1)
                end
            end
            task.wait(0.3)
        end
    end)
end

local function startAutoUpgrade()
    threads.autoUpgrade = task.spawn(function()
        while state.autoUpgrade do
            for _, r in ipairs(upgradeRemotes) do
                if not state.autoUpgrade then break end
                pcall(function() r:InvokeServer(1) end)
                task.wait(0.08)
            end
            task.wait(0.25)
        end
    end)
end

local function startAntiAFK()
    threads.antiAFK = task.spawn(function()
        while state.antiAFK do
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
            task.wait(15)
        end
    end)
end


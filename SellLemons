local function mkSlider(parent, order, icon, label, minV, maxV, defV, step, onChange)
    local card = Instance.new("Frame", parent)
    card.LayoutOrder = order; card.Size = UDim2.new(1, 0, 0, 60)
    card.BackgroundColor3 = C.card; card.BorderSizePixel = 0
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    local cs = Instance.new("UIStroke", card); cs.Color = C.stroke; cs.Thickness = 1

    local ib = Instance.new("Frame", card); ib.Size = UDim2.new(0, 32, 0, 32)
    ib.Position = UDim2.new(0, 10, 0, 10); ib.BackgroundColor3 = Color3.fromRGB(28, 28, 44)
    ib.BorderSizePixel = 0; Instance.new("UICorner", ib).CornerRadius = UDim.new(0, 7)
    local il = Instance.new("TextLabel", ib); il.Size = UDim2.new(1, 0, 1, 0)
    il.BackgroundTransparency = 1; il.Text = icon; il.TextSize = 16; il.Font = Enum.Font.GothamBold

    local nl = Instance.new("TextLabel", card); nl.Size = UDim2.new(1, -110, 0, 16)
    nl.Position = UDim2.new(0, 50, 0, 10); nl.BackgroundTransparency = 1; nl.Text = label
    nl.TextColor3 = C.text; nl.TextSize = 11; nl.Font = Enum.Font.GothamBold
    nl.TextXAlignment = Enum.TextXAlignment.Left

    local vl = Instance.new("TextLabel", card); vl.Size = UDim2.new(0, 52, 0, 16)
    vl.Position = UDim2.new(1, -58, 0, 10); vl.BackgroundTransparency = 1
    vl.TextColor3 = C.blue; vl.TextSize = 11; vl.Font = Enum.Font.GothamBold
    vl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", card)
    track.Size = UDim2.new(1, -62, 0, 5); track.Position = UDim2.new(0, 50, 0, 40)
    track.BackgroundColor3 = Color3.fromRGB(35, 35, 55); track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = C.blue
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.new(0, 13, 0, 13); knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0); knob.BackgroundColor3 = Color3.fromRGB(210, 225, 255)
    knob.BorderSizePixel = 0; knob.ZIndex = 2
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 7)

    local function setVal(v)
        v = math.clamp(math.round(v / step) * step, minV, maxV)
        local t = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, 0, 0.5, 0)
        vl.Text = tostring(v)
        onChange(v)
    end
    setVal(defV)

    local tb = Instance.new("TextButton", track)
    tb.Size = UDim2.new(1, 16, 1, 16); tb.Position = UDim2.new(0, -8, 0, -5)
    tb.BackgroundTransparency = 1; tb.Text = ""; tb.ZIndex = 5
    tb.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            activeDragCb = function(x)
                local ax, aw = track.AbsolutePosition.X, track.AbsoluteSize.X
                local t2 = math.clamp((x - ax) / aw, 0, 1)
                setVal(minV + t2 * (maxV - minV))
            end
            activeDragCb(inp.Position.X)
        end
    end)
end


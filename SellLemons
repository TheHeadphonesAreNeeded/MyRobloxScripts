-- ── TYCOON + REMOTES ────────────────────────────────────────
local function getPlayerTycoon()
    for _, obj in ipairs(game.Workspace:GetChildren()) do
        if obj.Name:sub(1,6) == "Tycoon" then
            local o = obj:FindFirstChild("Owner")
            if o and o.Value == lp then return obj end
        end
    end
end
local tycoon = getPlayerTycoon()
local allPurchaseData, upgradeRemotes = {}, {}
if tycoon then
    local function scan(inst, d)
        if d > 12 then return end
        if inst.ClassName == "RemoteFunction" then
            if inst.Name == "Purchase" then
                table.insert(allPurchaseData, {remote=inst, model=inst.Parent})
            elseif inst.Name == "Upgrade" then
                table.insert(upgradeRemotes, inst)
            end
        end
        for _, c in ipairs(inst:GetChildren()) do scan(c, d+1) end
    end
    scan(tycoon, 0)
end

-- ── STATE ───────────────────────────────────────────────────
local state = {
    autoBuy=false, autoUpgrade=false, antiAFK=false,
    fly=false, walkSpeed=32, jumpPower=50
}
local threads = {}

-- ── CHARACTER STATS ─────────────────────────────────────────
local function applyStats(char)
    char = char or lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = state.walkSpeed
        hum.JumpPower = state.jumpPower
    end
end

-- ── FLY ─────────────────────────────────────────────────────
local function stopFly()
    state.fly = false
    if threads.flyConn then threads.flyConn:Disconnect(); threads.flyConn = nil end
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, c in ipairs(hrp:GetChildren()) do
                if c:IsA("BodyVelocity") or c:IsA("BodyGyro") then c:Destroy() end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function startFly()
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true
    for _, c in ipairs(hrp:GetChildren()) do
        if c:IsA("BodyVelocity") or c:IsA("BodyGyro") then c:Destroy() end
    end

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent   = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.D = 400; bg.P = 10000
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    local cam = workspace.CurrentCamera

    if threads.flyConn then threads.flyConn:Disconnect() end
    threads.flyConn = RunService.Heartbeat:Connect(function()
        if not state.fly then
            threads.flyConn:Disconnect(); threads.flyConn = nil
            pcall(bv.Destroy, bv); pcall(bg.Destroy, bg)
            pcall(function() hum.PlatformStand = false end)
            return
        end
        local d = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W)           then d += cam.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)           then d -= cam.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)           then d -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)           then d += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then d += Vector3.yAxis          end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.yAxis          end
        if d.Magnitude > 1 then d = d.Unit end
        bv.Velocity = d * 80
        bg.CFrame   = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
    end)
end


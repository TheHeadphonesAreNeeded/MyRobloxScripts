    local ib = Instance.new("Frame", card); ib.Size = UDim2.new(0, 36, 0, 36)
    ib.Position = UDim2.new(0, 10, 0.5, -18); ib.BackgroundColor3 = Color3.fromRGB(28, 28, 44)
    ib.BorderSizePixel = 0; Instance.new("UICorner", ib).CornerRadius = UDim.new(0, 8)
    local il = Instance.new("TextLabel", ib); il.Size = UDim2.new(1, 0, 1, 0)
    il.BackgroundTransparency = 1; il.Text = icon; il.TextSize = 18; il.Font = Enum.Font.GothamBold

    local nl = Instance.new("TextLabel", card); nl.Size = UDim2.new(1, -118, 0, 19)
    nl.Position = UDim2.new(0, 54, 0, 11); nl.BackgroundTransparency = 1; nl.Text = label
    nl.TextColor3 = C.text; nl.TextSize = 12; nl.Font = Enum.Font.GothamBold
    nl.TextXAlignment = Enum.TextXAlignment.Left

    local sl = Instance.new("TextLabel", card); sl.Size = UDim2.new(1, -118, 0, 14)
    sl.Position = UDim2.new(0, 54, 0, 33); sl.BackgroundTransparency = 1; sl.Text = sub
    sl.TextColor3 = C.dim; sl.TextSize = 9.5; sl.Font = Enum.Font.Gotham
    sl.TextXAlignment = Enum.TextXAlignment.Left

    local pb = Instance.new("Frame", card); pb.Size = UDim2.new(0, 42, 0, 22)
    pb.Position = UDim2.new(1, -52, 0.5, -11); pb.BackgroundColor3 = Color3.fromRGB(42, 42, 62)
    pb.BorderSizePixel = 0; Instance.new("UICorner", pb).CornerRadius = UDim.new(0, 11)
    local dot = Instance.new("Frame", pb); dot.Size = UDim2.new(0, 16, 0, 16)
    dot.Position = UDim2.new(0, 3, 0, 3); dot.BackgroundColor3 = Color3.fromRGB(155, 155, 178)
    dot.BorderSizePixel = 0; Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 8)

    local active = false
    local function toggle(v)
        active = v
        if v then
            TweenService:Create(pb,   TI_CARD, {BackgroundColor3 = C.green}):Play()
            TweenService:Create(dot,  TI_CARD, {Position = UDim2.new(0, 23, 0, 3), BackgroundColor3 = Color3.new(1,1,1)}):Play()
            TweenService:Create(cs,   TI_CARD, {Color = C.green, Transparency = 0.5}):Play()
            TweenService:Create(card, TI_CARD, {BackgroundColor3 = Color3.fromRGB(17, 27, 17)}):Play()
        else
            TweenService:Create(pb,   TI_CARD, {BackgroundColor3 = Color3.fromRGB(42, 42, 62)}):Play()
            TweenService:Create(dot,  TI_CARD, {Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.fromRGB(155, 155, 178)}):Play()
            TweenService:Create(cs,   TI_CARD, {Color = C.stroke, Transparency = 0}):Play()
            TweenService:Create(card, TI_CARD, {BackgroundColor3 = C.card}):Play()
        end
        onToggle(v)
    end
    local clk = Instance.new("TextButton", card)
    clk.Size = UDim2.new(1, 0, 1, 0); clk.BackgroundTransparency = 1
    clk.Text = ""; clk.ZIndex = 6
    clk.MouseButton1Click:Connect(function() toggle(not active) end)
end

